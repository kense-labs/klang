FROM langarena:base_clang

ARG version
RUN git clone https://github.com/kense-labs/klang /opt/klang \
    && cd /opt/klang \
    && git checkout "$version" \
    && cmake -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target k -j \
    && ln -s /opt/klang/build/k /usr/local/bin/k
